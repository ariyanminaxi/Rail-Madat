# =============================================================================
# RailMaintain — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# --------------------------------
# Frontend Configuration
# --------------------------------
FRONTEND_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --------------------------------
# Backend Configuration
# --------------------------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# --------------------------------
# Supabase
# --------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --------------------------------
# Authentication
# --------------------------------
JWT_SECRET=
SECRET_KEY=
TOKEN_EXPIRY_MINUTES=480

# --------------------------------
# CORS
# --------------------------------
CORS_ORIGINS=

# --------------------------------
# Data Mode
# --------------------------------
# Options: supabase, csv, memory
DATA_MODE=csv
CSV_DATA_PATH=data

# --------------------------------
# ML Model
# --------------------------------
CONFIDENCE_THRESHOLD=0.75

# --------------------------------
# Admin (used by scripts/create_admin.py)
# --------------------------------
ADMIN_EMAIL=admin@railmaintain.local
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=System Administrator

# --------------------------------
# Application
# --------------------------------
DEBUG=false
